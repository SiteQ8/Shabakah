     "sudo iptables -L -n -v"),
]

def cheat_sheet():
    ar = get_lang() == "ar"
    print()
    print(bold(t("cheat_title")))
    print(dim("-" * 40))
    for label_en, label_ar, cmd in CHEAT:
        print("  " + (label_ar if ar else label_en))
        print("    " + green(cmd))
    print()

def _points(n):
    return count_noun(n, "point")

def ctf_board():
    lang = get_lang()
    found = get_found_flags()
    got, total = score()
    fg, ft = len([f for f in FLAGS if f["id"] in found]), len(FLAGS)
    print()
    print(bold(t("ctf_title")))
    print(dim("-" * 40))
    for line in _wrap(t("ctf_intro"), term_width() - 2):
        print("  " + line)
    print()
    print("  " + byellow(t("score_line") % (got, total, fg, ft)))
    print()
    for f in FLAGS:
        hit = f["id"] in found
        mark = bgreen("[x]") if hit else dim("[ ]")
        title = f["title_ar"] if lang == "ar" else f["title_en"]
        pts = dim(("(%s)" % _points(f["points"])).ljust(12))
        state = green(t("ctf_found")) if hit else dim(t("ctf_hidden"))
        print("  %s  %s  %s  %s" % (mark, bold(title.ljust(24)), pts, state))
        if hit:
            where = f["where_ar"] if lang == "ar" else f["where_en"]
            print("       " + dim(where))
    print()
    print("  " + dim(t("ctf_submit_usage")))
    print()

def cmd_submit(args):
    if not args:
        print(t("ctf_submit_usage"))
        return 2
    before = {a["id"] for a in _ach_defs() if a["unlocked"]}
    status, f = submit_flag(" ".join(args))
    lang = get_lang()
    if status == "new":
        title = f["title_ar"] if lang == "ar" else f["title_en"]
        print(bgreen("  " + t("ctf_new")) + "  " + bold(title)
              + "  " + dim("(+%s)" % _points(f["points"])))
        got, total = score()
        print("  " + byellow(t("score_short") % (got, total)))
        achs = _ach_defs()
        after = {a["id"] for a in achs if a["unlocked"]}
        for aid in sorted(after - before):
            a = next(x for x in achs if x["id"] == aid)
            print("  " + byellow(t("ach_new")) + " " + bold(a["ar"] if lang == "ar" else a["en"]))
        return 0
    if status == "already":
        print(dim("  " + t("ctf_already")))
        return 0
    print(red("  " + t("ctf_unknown")))
    return 1

def achievements_view():
    lang = get_lang()
    print()
    print(bold(t("ach_title")))
    print(dim("-" * 40))
    for a in _ach_defs():
        mark = bgreen("[x]") if a["unlocked"] else dim("[ ]")
        name = a["ar"] if lang == "ar" else a["en"]
        desc = a["desc_ar"] if lang == "ar" else a["desc_en"]
        print("  %s  %s" % (mark, bold(name)))
        print("       " + dim(desc))
    print()

def toggle_lang():
    set_lang("ar" if get_lang() == "en" else "en")
    print("  " + green(t("lang_set")))

# --- Reset and certificate ---------------------------------------------------

def cmd_reset(args):
    confirmed = "--yes" in args or "-y" in args
    if not confirmed:
        if not sys.stdin.isatty():
            print(t("reset_need_yes"))
            return 2
        try:
            reply = input(t("reset_confirm")).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            reply = ""
        confirmed = reply in ("yes", "y", "نعم")
    if not confirmed:
        print("  " + dim(t("reset_cancel")))
        return 1
    _save_json(PROGRESS_PATH, {"completed": [], "flags": []})
    print("  " + green(t("reset_done")))
    return 0

def _certificate_text(name, lang):
    lessons = load_lessons(lang)
    got, total = score()
    title = STR[lang]["cert_title"]
    body = STR[lang]["cert_body"] % (
        name, count_noun(len(lessons), "lesson", lang),
        count_noun(len(FLAGS), "flag", lang), count_noun(got, "point", lang))
    date = STR[lang]["cert_date"] % time.strftime("%Y-%m-%d")
    width = 64
    rule = "=" * width
    lines = [rule, "  SHABAKAH  |  شبكة", "  " + title, rule, ""]
    lines += ["  " + w for w in textwrap.wrap(body, width - 4)]
    lines += ["", "  " + date, "  github.com/SiteQ8/Shabakah", rule]
    return "\n".join(lines)

def cmd_certificate(args):
    lessons = load_lessons()
    left_l = sum(1 for m in lessons if not is_complete(m.get("id")))
    left_f = len(FLAGS) - len(get_found_flags())
    if left_l or left_f or not lessons:
        print("  " + t("cert_locked") % (left_l, left_f))
        return 1
    name = " ".join(args).strip()
    if not name and sys.stdin.isatty():
        try:
            name = input(t("cert_name_prompt")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
    if not name:
        try:
            name = getpass.getuser()
        except Exception:
            name = "learner"
    lang = get_lang()
    print()
    print(bcyan(_certificate_text(name, lang)))
    other = "en" if lang == "ar" else "ar"
    try:
        with open(CERT_PATH, "w", encoding="utf-8") as fh:
            fh.write(_certificate_text(name, lang) + "\n\n" + _certificate_text(name, other) + "\n")
        print("  " + dim(t("cert_saved") % CERT_PATH))
    except OSError:
        pass
    print()
    return 0

# --- Menu loop ---------------------------------------------------------------

def main_menu():
    banner()
    while True:
        print(bold(t("menu_title")))
        print(dim("-" * 40))
        items = [
            ("1", t("m_lessons")),
            ("2", t("m_progress")),
            ("3", t("m_targets")),
            ("4", t("m_cheat")),
            ("5", t("m_ctf")),
            ("6", t("m_achievements")),
            ("7", t("m_lang")),
            ("8", t("m_shell")),
            ("9", t("m_quit")),
        ]
        for k, label in items:
            print("  " + bold(k) + ")  " + label)
        print()
        try:
            sel = norm_answer(input(bold(t("choose") + ": "))).lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        print()
        if sel in ("1", "l"):
            lessons_menu()
        elif sel in ("2", "p"):
            show_progress()
        elif sel in ("3", "t"):
            targets_status()
        elif sel in ("4", "c"):
            cheat_sheet()
        elif sel in ("5", "f"):
            ctf_board()
        elif sel in ("6", "a"):
            achievements_view()
        elif sel in ("7",):
            toggle_lang()
            banner()
        elif sel in ("8", "s"):
            print("  " + dim(t("shell_note")))
            return
        elif sel in ("9", "q", "quit", "exit"):
            return
        else:
            print("  " + red(t("unknown_cmd")))

# --- CLI ---------------------------------------------------------------------

HELP = [
    ("netsec", "open the interactive guide", "افتح المرشد التفاعلي"),
    ("netsec lessons", "list all lessons", "اعرض قائمة الدروس"),
    ("netsec lesson <id>", "read one lesson", "اقرأ درسا محدّدا"),
    ("netsec next", "open the next unfinished lesson", "افتح أول درس لم تُنهه"),
    ("netsec check <id> <answer>", "check your challenge answer", "تحقّق من إجابة التحدي"),
    ("netsec targets", "show lab target status", "اعرض حالة أهداف التدريب"),
    ("netsec cheat", "command cheat sheet", "اعرض الأوامر السريعة"),
    ("netsec progress", "show your progress and score", "اعرض تقدّمك ونقاطك"),
    ("netsec ctf", "show the capture the flag board", "اعرض لوحة التحديات"),
    ("netsec ctf hint <id>", "show where a flag is hidden", "اعرض مكان رمز سري"),
    ("netsec submit flag{...}", "submit a flag you found", "سلّم رمزا كشفته"),
    ("netsec achievements", "show your badges", "اعرض شاراتك"),
    ("netsec certificate [name]", "print your completion certificate", "اطبع شهادة الإتمام"),
    ("netsec reset", "erase your progress and start over", "امحُ تقدّمك وابدأ من جديد"),
    ("netsec lang [en|ar]", "get or set the language", "اعرض اللغة أو غيّرها"),
    ("netsec version", "print the version", "اعرض رقم الإصدار"),
]

def cli_help():
    ar = get_lang() == "ar"
    print(bold(t("help_title")))
    print()
    for cmd, en, arabic in HELP:
        print("  " + cmd.ljust(28) + (arabic if ar else en))
    print()

def cmd_check(args):
    if len(args) < 2:
        print(t("check_usage"))
        return 2
    lesson_id = norm_answer(args[0])
    answer = " ".join(args[1:])
    meta = find_lesson(lesson_id)
    if not meta:
        print(red(t("no_such")))
        return 2
    result, feedback = run_challenge(meta, answer)
    if result is None:
        print(dim(t("no_challenge")))
        return 0
    if result:
        mark_complete(meta.get("id"))
        print(bgreen("  " + t("correct")))
        return 0
    print(red("  " + t("incorrect")))
    if feedback:
        print(dim("  " + feedback))
    return 1

def main(argv):
    if not argv:
        main_menu()
        return 0
    cmd = argv[0].lower()
    rest = argv[1:]
    if cmd in ("lessons", "list"):
        show_lessons_list()
    elif cmd == "lesson":
        if not rest:
            show_lessons_list()
        else:
            meta = find_lesson(norm_answer(rest[0]))
            if not meta:
                print(red(t("no_such")))
                return 2
            show_lesson(meta)
    elif cmd == "next":
        meta = next_lesson()
        if not meta:
            print("  " + green(t("all_done")))
        else:
            show_lesson(meta)
    elif cmd == "check":
        return cmd_check(rest)
    elif cmd == "targets":
        targets_status()
    elif cmd == "cheat":
        cheat_sheet()
    elif cmd == "progress":
        show_progress()
    elif cmd in ("ctf", "flags"):
        if rest and rest[0].lower() == "hint":
            if len(rest) < 2:
                print(t("ctf_hint_usage"))
                print(dim(t("ctf_ids") % ", ".join(f["id"] for f in FLAGS)))
                return 2
            f = _flag_by_id(rest[1].strip().lower())
            if not f:
                print(red(t("ctf_unknown")))
                print(dim(t("ctf_ids") % ", ".join(f["id"] for f in FLAGS)))
                return 2
            print("  " + (f["where_ar"] if get_lang() == "ar" else f["where_en"]))
        else:
            ctf_board()
    elif cmd == "submit":
        return cmd_submit(rest)
    elif cmd in ("achievements", "ach"):
        achievements_view()
    elif cmd in ("certificate", "cert"):
        return cmd_certificate(rest)
    elif cmd == "reset":
        return cmd_reset(rest)
    elif cmd == "lang":
        if rest:
            set_lang(rest[0].lower())
            print(t("lang_set"))
        print(t("lang_now") % get_lang())
    elif cmd in ("version", "-v", "--version"):
        print("shabakah " + VERSION)
    elif cmd in ("help", "-h", "--help"):
        cli_help()
    else:
        print(red(t("unknown_cmd")))
        cli_help()
        return 2
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except BrokenPipeError:
        # A reader closed early (piping into head, grep -q, and the like).
        # Redirect stdout to devnull so the interpreter shutdown flush stays quiet.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except Exception:
            pass
        sys.exit(0)
