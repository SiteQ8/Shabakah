def t(key):
    lang = get_lang()
    return STR.get(lang, STR["en"]).get(key, STR["en"].get(key, key))

# Counted nouns. Arabic agreement follows the last two digits of the number:
# 3 to 10 take a plural, 11 to 99 a singular, round hundreds a singular.
NOUNS = {
    "lesson": {"en": ("lesson", "lessons"),
               "ar": ("درس واحد", "درسان", "دروس", "درسا", "درس")},
    "point":  {"en": ("point", "points"),
               "ar": ("نقطة واحدة", "نقطتان", "نقاط", "نقطة", "نقطة")},
    "flag":   {"en": ("secret flag", "secret flags"),
               "ar": ("رمز سري واحد", "رمزان سريان", "رموز سرية", "رمزا سريا", "رمز سري")},
    "badge":  {"en": ("badge", "badges"),
               "ar": ("شارة واحدة", "شارتان", "شارات", "شارة", "شارة")},
}

def count_noun(n, noun, lang=None):
    lang = lang or get_lang()
    if lang == "ar":
        one, two, few, many, hundred = NOUNS[noun]["ar"]
        if n == 1:
            return one
        if n == 2:
            return two
        r = n % 100
        if 3 <= r <= 10:
            return "%d %s" % (n, few)
        if 11 <= r <= 99:
            return "%d %s" % (n, many)
        return "%d %s" % (n, hundred)
    one, many = NOUNS[noun]["en"]
    return "%d %s" % (n, one if n == 1 else many)

# Arabic and Persian digits in an answer count as plain digits.
_DIGITS = str.maketrans("٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹", "01234567890123456789")

def norm_answer(s):
    return (s or "").translate(_DIGITS).strip()

# --- State -------------------------------------------------------------------

def _ensure_state():
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
    except OSError:
        pass

def _load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return dict(default)

def _save_json(path, data):
    _ensure_state()
    try:
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2)
    except OSError:
        pass

def get_config():
    return _load_json(CONFIG_PATH, {"lang": "en"})

def get_lang():
    lang = get_config().get("lang", "en")
    return lang if lang in ("en", "ar") else "en"

def set_lang(lang):
    cfg = get_config()
    cfg["lang"] = lang if lang in ("en", "ar") else "en"
    _save_json(CONFIG_PATH, cfg)

def get_progress():
    return _load_json(PROGRESS_PATH, {"completed": []})

def mark_complete(lesson_id):
    prog = get_progress()
    done = set(prog.get("completed", []))
    done.add(str(lesson_id))
    prog["completed"] = sorted(done)
    _save_json(PROGRESS_PATH, prog)

def is_complete(lesson_id):
    return str(lesson_id) in set(get_progress().get("completed", []))

# --- Capture the flag --------------------------------------------------------
