def _flag_by_id(fid):
    for f in FLAGS:
        if f["id"] == fid:
            return f
    return None

def get_found_flags():
    return set(get_progress().get("flags", []))

def record_flag(fid):
    prog = get_progress()
    found = set(prog.get("flags", []))
    found.add(fid)
    prog["flags"] = sorted(found)
    _save_json(PROGRESS_PATH, prog)

def _digest(text):
    return hashlib.sha256(text.strip().encode("utf-8", "replace")).hexdigest()

def submit_flag(text):
    """Return (status, flag_dict). status in new, already, unknown."""
    digest = _digest(text)
    for f in FLAGS:
        if digest == f["sha256"]:
            if f["id"] in get_found_flags():
                return "already", f
            record_flag(f["id"])
            return "new", f
    return "unknown", None

def score():
    found = get_found_flags()
    got = sum(f["points"] for f in FLAGS if f["id"] in found)
    total = sum(f["points"] for f in FLAGS)
    return got, total

# --- Achievements ------------------------------------------------------------
# Derived from progress, not stored separately. Each has a predicate.

def _ach_defs():
    lessons = load_lessons()
    total_l = len(lessons)
    done_l = sum(1 for m in lessons if is_complete(m.get("id")))
    found = get_found_flags()
    return [
        {"id": "first_lesson", "en": "First light", "ar": "أول خطوة",
         "desc_en": "Complete your first lesson", "desc_ar": "أكمل أول درس",
         "unlocked": done_l >= 1},
        {"id": "halfway", "en": "Halfway there", "ar": "منتصف الطريق",
         "desc_en": "Complete half the lessons", "desc_ar": "أكمل نصف الدروس",
         "unlocked": bool(total_l) and done_l >= (total_l + 1) // 2},
        {"id": "all_lessons", "en": "Full sweep", "ar": "إتمام كامل",
         "desc_en": "Complete every lesson", "desc_ar": "أكمل الدروس كلها",
         "unlocked": bool(total_l) and done_l == total_l},
        {"id": "first_flag", "en": "First blood", "ar": "أول صيد",
         "desc_en": "Capture your first flag", "desc_ar": "اكشف أول رمز سري",
         "unlocked": len(found) >= 1},
        {"id": "half_flags", "en": "Treasure hunter", "ar": "صائد الكنوز",
         "desc_en": "Capture half the flags", "desc_ar": "اكشف نصف الرموز السرية",
         "unlocked": len(found) >= (len(FLAGS) + 1) // 2},
        {"id": "all_flags", "en": "Clean board", "ar": "لوحة نظيفة",
         "desc_en": "Capture every flag", "desc_ar": "اكشف الرموز السرية كلها",
         "unlocked": len(found) == len(FLAGS)},
        {"id": "perfect", "en": "Shabakah master", "ar": "أستاذ شبكة",
         "desc_en": "All lessons done and all flags found",
         "desc_ar": "أنهِ الدروس كلها واكشف الرموز السرية كلها",
         "unlocked": bool(total_l) and done_l == total_l and len(found) == len(FLAGS)},
    ]

# --- Lesson loading ----------------------------------------------------------

def lessons_dir(lang=None):
    return os.path.join(LESSON_ROOT, lang or get_lang())

def parse_lesson(path):
    """Parse a lesson file: a simple key: value front matter between two
    '---' fences, then a markdown body. No external yaml needed."""
    with open(path, "r", encoding="utf-8") as fh:
        raw = fh.read()
    meta = {}
    body = raw
    lines = raw.splitlines()
    if lines and lines[0].strip() == "---":
        end = None
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                end = i
                break
        if end is not None:
            for line in lines[1:end]:
                if not line.strip() or line.strip().startswith("#"):
                    continue
                if ":" in line:
                    k, v = line.split(":", 1)
                    meta[k.strip()] = v.strip()
            body = "\n".join(lines[end + 1:]).strip("\n")
    return meta, body

def load_lessons(lang=None):
    d = lessons_dir(lang)
    out = []
    if not os.path.isdir(d):
        return out
    for name in sorted(os.listdir(d)):
        if not name.endswith(".md"):
            continue
        path = os.path.join(d, name)
        try:
            meta, body = parse_lesson(path)
        except Exception:
            continue
        if not meta.get("id"):
            continue
        meta["_body"] = body
        meta["_path"] = path
        out.append(meta)
    out.sort(key=lambda m: str(m.get("id")))
    return out

def find_lesson(lesson_id):
    lid = str(lesson_id).lstrip("0") or "0"
    for m in load_lessons():
        mid = str(m.get("id"))
        if mid == str(lesson_id) or (mid.lstrip("0") or "0") == lid:
            return m
    return None

def next_lesson():
    for m in load_lessons():
        if not is_complete(m.get("id")):
            return m
    return None

# --- Markdown to terminal ----------------------------------------------------

def term_width():
    return max(60, min(shutil.get_terminal_size((90, 24)).columns, 100))

def _inline(s):
    # bold **x**
    s = re.sub(r"\*\*(.+?)\*\*", lambda m: bold(m.group(1)), s)
    # inline code `x`
    s = re.sub(r"`([^`]+?)`", lambda m: yellow(m.group(1)), s)
    return s

_KEEP = "\x00"

def _wrap(text, width):
    """Wrap on the plain text, then style each line, so colour codes never
    count toward the width and an inline command never splits in two."""
    protected = re.sub(r"`[^`]+`", lambda m: m.group(0).replace(" ", _KEEP), text)
    lines = textwrap.wrap(protected, max(20, width), break_long_words=False,
                          break_on_hyphens=False) or [""]
    return [_inline(line.replace(_KEEP, " ")) for line in lines]

def render_markdown(body):
    width = term_width()
    out = []
    in_code = False
    for line in body.splitlines():
        stripped = line.rstrip("\n")
        if stripped.strip().startswith("```"):
            in_code = not in_code
            out.append(dim("  " + "." * (width - 4)))
            continue
        if in_code:
            out.append("  " + green(stripped))
            continue
        if stripped.startswith("### "):
            out.append("")
            out.append(byellow(stripped[4:].strip()))
            continue
        if stripped.startswith("## "):
            out.append("")
            out.append(bcyan(stripped[3:].strip()))
            continue
        if stripped.startswith("# "):
            out.append("")
            out.append(bold(stripped[2:].strip()))
            out.append(dim("=" * min(width, len(stripped) + 2)))
            continue
        if stripped.strip().startswith("> "):
            for w in _wrap(stripped.strip()[2:], width - 4):
                out.append("  " + dim("| ") + w)
            continue
        m = re.match(r"^(\s*)[-*]\s+(.*)$", stripped)
        if m:
            indent = len(m.group(1))
            wrapped = _wrap(m.group(2), width - 6 - indent)
            out.append(" " * indent + cyan("  - ") + wrapped[0])
            for cont in wrapped[1:]:
                out.append(" " * (indent + 4) + cont)
            continue
        m = re.match(r"^(\s*)(\d+)\.\s+(.*)$", stripped)
        if m:
            indent = len(m.group(1))
            wrapped = _wrap(m.group(3), width - 6 - indent)
            out.append(" " * indent + cyan("  %s. " % m.group(2)) + wrapped[0])
            for cont in wrapped[1:]:
                out.append(" " * (indent + 5) + cont)
            continue
        if not stripped.strip():
            out.append("")
            continue
        out.extend(_wrap(stripped, width))
    return "\n".join(out)

def page(text):
    # SHABAKAH_NOPAGER=1 prints straight to the terminal (used for screenshots).
    if sys.stdout.isatty() and shutil.which("less") and not os.environ.get("SHABAKAH_NOPAGER"):
        try:
            p = subprocess.Popen(["less", "-R", "-X", "-F"], stdin=subprocess.PIPE)
            p.communicate(text.encode("utf-8", "replace"))
            return
        except Exception:
            pass
    print(text)

# --- Live checks against the local targets -----------------------------------

def _tcp_connect(host, port, timeout=1.5):
    try:
        s = socket.create_connection((host, port), timeout=timeout)
        return s
    except Exception:
        return None

def _udp_ping(port, timeout=1.0):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(timeout)
        s.sendto(b"PING", ("127.0.0.1", port))
        data, _ = s.recvfrom(512)
        s.close()
        return data.decode("latin-1", "replace").strip()
    except Exception:
        return None

def _read_http(s, timeout):
    chunks = []
    s.settimeout(timeout)
    while True:
        b = s.recv(4096)
        if not b:
            break
        chunks.append(b)
    data = b"".join(chunks).decode("latin-1", "replace")
    if "\r\n\r\n" in data:
        head, body = data.split("\r\n\r\n", 1)
    else:
        head, body = data, ""
    return head, body

def _http_get(path="/", host="127.0.0.1", port=TARGET_HTTP, timeout=2.0):
    s = _tcp_connect(host, port, timeout)
    if not s:
        return None, ""
    try:
        req = "GET %s HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n\r\n" % (path, host)
        s.sendall(req.encode())
        return _read_http(s, timeout)
    except Exception:
        return "", ""
    finally:
        s.close()

def _https_get(path="/", port=TARGET_HTTPS, timeout=2.0):
    ctx = ssl._create_unverified_context()
    raw = _tcp_connect("127.0.0.1", port, timeout)
    if not raw:
        return None, ""
    try:
        s = ctx.wrap_socket(raw, server_hostname="shabakah.lab")
        req = "GET %s HTTP/1.0\r\nHost: shabakah.lab\r\nConnection: close\r\n\r\n" % path
        s.sendall(req.encode())
        head, body = _read_http(s, timeout)
        s.close()
        return head, body
    except Exception:
        try:
            raw.close()
        except Exception:
            pass
        return "", ""

def _listening_tcp_ports():
    ports = set()
    try:
        out = subprocess.check_output(["ss", "-H", "-ltn"], stderr=subprocess.DEVNULL).decode()
    except Exception:
        try:
            out = subprocess.check_output(["netstat", "-ltn"], stderr=subprocess.DEVNULL).decode()
        except Exception:
            return ports
    for line in out.splitlines():
        # The local address column ends in :port; peers show :* and are skipped.
        for tok in line.split():
            mm = re.search(r":(\d+)$", tok)
            if mm:
                try:
                    ports.add(int(mm.group(1)))
                except ValueError:
                    pass
    return ports

_NUMBER_WORDS = {
    "zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
    "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
    "صفر": 0, "واحد": 1, "واحدة": 1, "اثنان": 2, "اثنتان": 2, "اثنين": 2,
    "ثلاثة": 3, "ثلاث": 3, "أربعة": 4, "اربعة": 4, "أربع": 4, "اربع": 4,
    "خمسة": 5, "خمس": 5, "ستة": 6, "ست": 6, "سبعة": 7, "سبع": 7,
    "ثمانية": 8, "ثماني": 8, "تسعة": 9, "تسع": 9, "عشرة": 10, "عشر": 10,
}

def _parse_number(answer):
    a = norm_answer(answer)
    digits = re.findall(r"\d+", a)
    if digits:
        return int(digits[0])
    for word, value in _NUMBER_WORDS.items():
        if re.search(r"(^|\s)%s($|\s)" % re.escape(word), a.lower()):
            return value
    return None

def check_listening_tcp_count(answer):
    truth = len(_listening_tcp_ports())
    given = _parse_number(answer)
    if given is None:
        return False, t("fb_number")
    if given == truth:
        return True, ""
    return False, t("fb_listen")

def check_http_server_banner(answer):
    head, _ = _http_get("/")
    if head is None:
        return False, t("fb_web_down") % TARGET_HTTP
    m = re.search(r"(?im)^Server:\s*(.+?)\s*$", head)
    truth = m.group(1) if m else ""
    a = answer.strip().lower()
    if truth and (truth.lower() in a or (a and a in truth.lower())):
        return True, ""
    return False, t("fb_server_hdr") % TARGET_HTTP

def check_http_lab_token(answer):
    head, _ = _http_get("/")
    if head is None:
        return False, t("fb_web_down") % TARGET_HTTP
    m = re.search(r"(?im)^X-Lab-Token:\s*(.+?)\s*$", head)
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, t("fb_lab_token")

def check_http_cleartext_cred(answer):
    head, body = _http_get("/login")
    if head is None:
        return False, t("fb_web_down") % TARGET_HTTP
    m = re.search(r"password=([^\s<\"']+)", body or "")
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, t("fb_login") % TARGET_HTTP

def check_tls_cn(answer):
    ctx = ssl._create_unverified_context()
    cert = None
    try:
        raw = socket.create_connection(("127.0.0.1", TARGET_HTTPS), timeout=2.0)
        ss = ctx.wrap_socket(raw, server_hostname="shabakah.lab")
        cert = ss.getpeercert()
        ss.close()
    except Exception:
        cert = None
    truth = ""
    if cert:
        for tup in cert.get("subject", ()):
            for k, v in tup:
                if k == "commonName":
                    truth = v
    if not truth and shutil.which("openssl"):
        # getpeercert on an unverified context can be empty; ask openssl.
        try:
            out = subprocess.check_output(
                "echo | openssl s_client -connect 127.0.0.1:%d 2>/dev/null "
                "| openssl x509 -noout -subject 2>/dev/null" % TARGET_HTTPS,
                shell=True).decode()
            m = re.search(r"CN\s*=\s*([^,/\n]+)", out)
            truth = m.group(1).strip() if m else ""
        except Exception:
            truth = ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, t("fb_tls") % TARGET_HTTPS

def check_enum_banner(answer):
    s = _tcp_connect("127.0.0.1", TARGET_ENUM)
    if not s:
        return False, t("fb_enum_down") % TARGET_ENUM
    try:
        s.settimeout(2.0)
        data = s.recv(256).decode("latin-1", "replace")
    except Exception:
        data = ""
    finally:
        s.close()
    m = re.search(r"(v\d+(?:\.\d+)?)", data)
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, t("fb_enum") % TARGET_ENUM

def check_open_ports(answer):
    # Every TCP practice service counts, the forgotten console included.
    lab_ports = [TARGET_CONSOLE, TARGET_HTTP, TARGET_HTTPS, TARGET_ENUM]
    allowed = set(lab_ports) | {22, TARGET_DNS}
    open_now = set()
    for p in lab_ports:
        s = _tcp_connect("127.0.0.1", p, timeout=1.0)
        if s:
            open_now.add(p)
            s.close()
    if not open_now:
        return False, t("fb_targets_down")
    given = set(int(x) for x in re.findall(r"\d+", norm_answer(answer)))
    if open_now.issubset(given) and given.issubset(allowed):
        return True, ""
    return False, t("fb_ports")

def check_dns_web_ip(answer):
    truth = ""
    if shutil.which("dig"):
        try:
            out = subprocess.check_output(
                ["dig", "+short", "@127.0.0.1", "-p", str(TARGET_DNS), "web.shabakah.lab", "A"],
                stderr=subprocess.DEVNULL).decode().strip()
            truth = out.splitlines()[0].strip() if out else ""
        except Exception:
            truth = ""
    if truth and truth in norm_answer(answer):
        return True, ""
    return False, t("fb_dns") % TARGET_DNS

def check_udp_banner(answer):
    reply = _udp_ping(TARGET_UDP, timeout=2.0)
    if reply is None:
        return False, t("fb_udp_down") % TARGET_UDP
    if reply and reply.lower() in answer.lower():
        return True, ""
    return False, t("fb_udp") % TARGET_UDP

def check_console_hostname(answer):
    try:
        s = socket.create_connection(("127.0.0.1", TARGET_CONSOLE), timeout=2.0)
        s.settimeout(3.0)

        def until(marker):
            buf = b""
            while marker not in buf and len(buf) < 4096:
                chunk = s.recv(256)
                if not chunk:
                    break
                buf += chunk
            return buf

        until(b"login:")
        s.sendall(b"admin\r\n")
        until(b"Password:")
        s.sendall(b"lab-P@ss\r\n")
        until(b"console>")
        s.sendall(b"HOSTNAME\r\n")
        out = until(b"console>").decode("latin-1", "replace")
        s.sendall(b"LOGOUT\r\n")
        s.close()
    except Exception:
        return False, t("fb_console_down") % TARGET_CONSOLE
    truth = ""
    for line in out.splitlines():
        line = line.strip()
        if line and "console>" not in line and "welcome" not in line.lower():
            truth = line
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, t("fb_console") % TARGET_CONSOLE

def check_missing_security_headers(answer):
    head, _ = _https_get("/")
    if not head:
        return False, t("fb_headers_down") % TARGET_HTTPS
    present = set()
    for line in head.split("\r\n")[1:]:
        if ":" in line:
            present.add(line.split(":", 1)[0].strip().lower())
    truth = sum(1 for h in SECURITY_HEADERS if h.lower() not in present)
    given = _parse_number(answer)
    if given is None:
        return False, t("fb_number")
    if given == truth:
        return True, ""
    return False, t("fb_headers") % TARGET_HTTPS

def check_http_title(answer):
    head, body = _http_get("/")
    if head is None:
        return False, t("fb_title_down") % TARGET_HTTP
    m = re.search(r"(?is)<title>(.*?)</title>", body or "")
    truth = m.group(1).strip() if m else ""
    if truth and truth.lower() in answer.strip().lower():
        return True, ""
    return False, t("fb_title") % TARGET_HTTP

DYNAMIC_CHECKS = {
    "listening_tcp_count": check_listening_tcp_count,
    "http_server_banner": check_http_server_banner,
    "http_lab_token": check_http_lab_token,
    "http_cleartext_cred": check_http_cleartext_cred,
    "tls_cn": check_tls_cn,
    "enum_banner": check_enum_banner,
    "open_ports": check_open_ports,
    "dns_web_ip": check_dns_web_ip,
    "udp_banner": check_udp_banner,
    "console_hostname": check_console_hostname,
    "missing_security_headers": check_missing_security_headers,
    "http_title": check_http_title,
}

def check_static(answer, expected, mode):
    a = norm_answer(answer)
    e = (expected or "").strip()
    if mode == "regex":
        try:
            return bool(re.search(e, a, re.IGNORECASE)), ""
        except re.error:
            return False, ""
    if mode == "exact":
        return a.lower() == e.lower(), ""
    # default: contains, in either direction, split accepted answers on |
    for alt in e.split("|"):
        alt = alt.strip()
        if alt and (alt.lower() in a.lower() or a.lower() == alt.lower()):
            return True, ""
    return False, ""

def run_challenge(meta, answer):
    ctype = meta.get("challenge_type", "").strip()
    if ctype == "dynamic":
        fn = DYNAMIC_CHECKS.get(meta.get("challenge_check", "").strip())
        if not fn:
            return None, ""
        return fn(answer)
    if ctype == "static":
        ok, _ = check_static(answer, meta.get("challenge_answer", ""),
                             meta.get("challenge_match", "contains"))
        return ok, ""
    return None, ""

# --- Views -------------------------------------------------------------------

def banner():
    lang = get_lang()
    line = cyan("=" * 64)
    print(line)
    print(bcyan("  SHABAKAH  ") + dim("|") + "  " + bold("شبكة"))
    print("  " + dim(t("tagline")))
    print("  " + dim("v" + VERSION + "  |  github.com/SiteQ8/Shabakah"))
    print(line)
    print("  " + yellow(t("authorized")))
    lessons = load_lessons()
    done = sum(1 for m in lessons if is_complete(m.get("id")))
    got, ptotal = score()
    if done or got:
        les = "%d/%d" % (done, len(lessons))
        pts = "%d/%d" % (got, ptotal)
        if lang == "ar":
            print("  " + dim(t("welcome_back")) + "   " + dim(t("bn_lessons")) + " "
                  + green(les) + "   " + dim(t("bn_points")) + " " + byellow(pts))
        else:
            print("  " + dim(t("welcome_back")) + "  " + green(les) + " "
                  + dim(t("bn_lessons")) + "  " + byellow(pts) + " " + dim(t("bn_points")))
        nxt = next_lesson()
        if nxt:
            print("  " + dim(t("next_up") % (nxt.get("id"), nxt.get("title", ""))
                             + "  " + t("next_cmd")))
        else:
            print("  " + green(t("all_done")))
    print()

def show_lessons_list():
    lessons = load_lessons()
    print()
    print(bold(t("lessons_title")))
    print(dim("-" * 40))
    for m in lessons:
        mark = bgreen("[x]") if is_complete(m.get("id")) else dim("[ ]")
        num = bold("%2s" % m.get("id"))
        print("  %s  %s  %s" % (mark, num, m.get("title", "")))
    print()

def _strip_leading_h1(body):
    lines = body.split("\n")
    i = 0
    while i < len(lines) and not lines[i].strip():
        i += 1
    if i < len(lines) and lines[i].lstrip().startswith("# "):
        del lines[i]
        if i < len(lines) and not lines[i].strip():
            del lines[i]
    return "\n".join(lines)

def show_lesson(meta):
    width = term_width()
    body = render_markdown(_strip_leading_h1(meta.get("_body", "")))
    parts = []
    parts.append(bold("# " + meta.get("title", "")))
    parts.append(dim("=" * min(width, 60)))
    if meta.get("objective"):
        parts.append("")
        parts.extend(_wrap("**%s:** %s" % (t("objective"), meta["objective"]), width))
    parts.append("")
    parts.append(body)
    parts.append("")
    parts.append(cyan("-" * min(width, 60)))
    parts.append(byellow(t("challenge")))
    if meta.get("challenge_prompt"):
        parts.extend(_wrap(meta["challenge_prompt"], width))
    if meta.get("challenge_hint"):
        for line in _wrap(t("hint") + ": " + meta["challenge_hint"], width):
            parts.append(dim(line))
    if meta.get("challenge_type", "") in ("static", "dynamic"):
        parts.append("")
        parts.append(t("try_check"))
        parts.append("  " + green("netsec check %s %s" % (meta.get("id"), t("your_answer"))))
    else:
        parts.append(dim(t("no_challenge")))
    parts.append("")
    page("\n".join(parts))

def lessons_menu():
    while True:
        show_lessons_list()
        try:
            sel = input(bold(t("pick_lesson") + ": ")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if sel.lower() in ("b", "back", "q", ""):
            return
        meta = find_lesson(norm_answer(sel))
        if not meta:
            print("  " + red(t("no_such")))
            continue
        show_lesson(meta)
        try:
            input(dim("  " + t("press_enter") + " "))
        except (EOFError, KeyboardInterrupt):
            print()
            return

def show_progress():
    lessons = load_lessons()
    total = len(lessons)
    done = sum(1 for m in lessons if is_complete(m.get("id")))
    print()
    print(bold(t("progress_title")))
    print(dim("-" * 40))
    width = 30
    filled = int(width * done / total) if total else 0
    bar = bgreen("#" * filled) + dim("." * (width - filled))
    print("  [" + bar + "]  %d/%d" % (done, total))
    print()
    print("  " + (t("completed_n") % (done, total)))
    got, ptotal = score()
    found = len(get_found_flags())
    print("  " + (t("score_line") % (got, ptotal, found, len(FLAGS))))
    achs = _ach_defs()
    unlocked = sum(1 for a in achs if a["unlocked"])
    print("  " + t("ach_count") % (unlocked, len(achs)))
    print()

# name_en, note_en, name_ar, note_ar, port, protocol
TARGETS = [
    ("SSH", "the door you came in through",
     "SSH", "الباب الذي دخلت منه", 22, "tcp"),
    ("HTTP, cleartext web", "banners, headers and cleartext",
     "HTTP، ويب بنص صريح", "اللافتات والترويسات والنص الصريح", TARGET_HTTP, "tcp"),
    ("HTTPS, TLS web", "certificates and security headers",
     "HTTPS، ويب عبر TLS", "الشهادات وترويسات الأمان", TARGET_HTTPS, "tcp"),
    ("ENUM, raw TCP banner", "service enumeration",
     "ENUM، لافتة TCP", "تعداد الخدمات", TARGET_ENUM, "tcp"),
    ("CONSOLE, cleartext login", "a reused password",
     "CONSOLE، دخول بنص صريح", "كلمة مرور معادة الاستخدام", TARGET_CONSOLE, "tcp"),
    ("DNS, lab resolver", "name resolution",
     "DNS، خادم أسماء المختبر", "الاستعلام عن الأسماء", TARGET_DNS, "tcp"),
    ("UDP, banner service", "UDP scanning",
     "UDP، خدمة لافتة", "مسح منافذ UDP", TARGET_UDP, "udp"),
]

def _target_up(port, proto):
    if proto == "udp":
        return _udp_ping(port, timeout=0.8) is not None
    s = _tcp_connect("127.0.0.1", port, timeout=0.8)
    if s:
        s.close()
        return True
    return False

def targets_status():
    ar = get_lang() == "ar"
    print()
    print(bold(t("targets_title")))
    print(dim("-" * 40))
    cell = max(len(t("up")), len(t("down"))) + 2
    for name_en, note_en, name_ar, note_ar, port, proto in TARGETS:
        up = _target_up(port, proto)
        word = (" " + (t("up") if up else t("down"))).ljust(cell)
        state = bgreen(word) if up else red(word)
        where = "%d/%s" % (port, proto)
        name = name_ar if ar else name_en
        note = note_ar if ar else note_en
        print("  %s  %s  %s  %s" % (state, bold(where.ljust(9)), name.ljust(26), dim(note)))
    print()

CHEAT = [
    ("See what is listening locally", "اعرض ما يستمع على هذا الجهاز",
     "ss -ltnp"),
    ("Show interfaces and addresses", "اعرض الواجهات والعناوين والمسارات",
     "ip addr ; ip route"),
    ("Connect scan of every port", "امسح المنافذ كلها بفحص الاتصال",
     "nmap -sT -p- 127.0.0.1"),
    ("Service and version detection", "اكشف الخدمات وإصداراتها",
     "nmap -sV -p 2323,8080,8443,9000 127.0.0.1"),
    ("Run an nmap script", "شغّل برنامجا نصيا من nmap",
     "nmap -sT -p 8080 --script http-title 127.0.0.1"),
    ("Read HTTP headers", "اقرأ ترويسات HTTP",
     "curl -sI http://127.0.0.1:8080"),
    ("Check security headers", "افحص ترويسات الأمان",
     "curl -skI https://127.0.0.1:8443/"),
    ("Read a raw TCP banner", "اقرأ لافتة خدمة TCP",
     "nc 127.0.0.1 9000"),
    ("Inspect a TLS certificate", "افحص شهادة TLS",
     "echo | openssl s_client -connect 127.0.0.1:8443 2>/dev/null | openssl x509 -noout -subject -issuer -dates"),
    ("Resolve a name at the lab DNS", "استعلم عن اسم من خادم أسماء المختبر",
     "dig @127.0.0.1 -p 5353 web.shabakah.lab"),
    ("Capture traffic on loopback", "التقط الحزم على واجهة الاسترجاع",
