# --- Lesson loading ----------------------------------------------------------

def lessons_dir():
    return os.path.join(LESSON_ROOT, get_lang())

def parse_lesson(path):
    """Parse a lesson file: a simple key: value front matter between two
    '---' fences, then a markdown body. No external yaml needed."""
    with open(path, "r", encoding="utf-8") as fh:
        raw = fh.read()
    meta = {}
    body = raw
    lines = raw.splitlines()
    if lines and lines[0].strip() == "---":
        end = None
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                end = i
                break
        if end is not None:
            for line in lines[1:end]:
                if not line.strip() or line.strip().startswith("#"):
                    continue
                if ":" in line:
                    k, v = line.split(":", 1)
                    meta[k.strip()] = v.strip()
            body = "\n".join(lines[end + 1:]).strip("\n")
    return meta, body

def load_lessons():
    d = lessons_dir()
    out = []
    if not os.path.isdir(d):
        return out
    for name in sorted(os.listdir(d)):
        if not name.endswith(".md"):
            continue
        path = os.path.join(d, name)
        try:
            meta, body = parse_lesson(path)
        except Exception:
            continue
        if not meta.get("id"):
            continue
        meta["_body"] = body
        meta["_path"] = path
        out.append(meta)
    out.sort(key=lambda m: str(m.get("id")))
    return out

def find_lesson(lesson_id):
    lid = str(lesson_id).lstrip("0") or "0"
    for m in load_lessons():
        mid = str(m.get("id"))
        if mid == str(lesson_id) or (mid.lstrip("0") or "0") == lid:
            return m
    return None

# --- Markdown to terminal ----------------------------------------------------

def term_width():
    return max(60, min(shutil.get_terminal_size((90, 24)).columns, 100))

def _inline(s):
    # bold **x**
    s = re.sub(r"\*\*(.+?)\*\*", lambda m: bold(m.group(1)), s)
    # inline code `x`
    s = re.sub(r"`([^`]+?)`", lambda m: yellow(m.group(1)), s)
    return s

def render_markdown(body):
    width = term_width()
    out = []
    in_code = False
    for line in body.splitlines():
        stripped = line.rstrip("\n")
        if stripped.strip().startswith("```"):
            in_code = not in_code
            if in_code:
                out.append(dim("  " + "." * (width - 4)))
            else:
                out.append(dim("  " + "." * (width - 4)))
            continue
        if in_code:
            out.append("  " + green(stripped))
            continue
        if stripped.startswith("### "):
            out.append("")
            out.append(byellow(stripped[4:].strip()))
            continue
        if stripped.startswith("## "):
            out.append("")
            out.append(bcyan(stripped[3:].strip()))
            continue
        if stripped.startswith("# "):
            out.append("")
            out.append(bold(stripped[2:].strip()))
            out.append(dim("=" * min(width, len(stripped) + 2)))
            continue
        if stripped.strip().startswith("> "):
            txt = stripped.strip()[2:]
            for w in textwrap.wrap(txt, width - 4) or [""]:
                out.append("  " + dim("| " + w))
            continue
        m = re.match(r"^(\s*)[-*]\s+(.*)$", stripped)
        if m:
            indent = len(m.group(1))
            text = _inline(m.group(2))
            prefix = " " * indent + cyan("  - ")
            wrapped = textwrap.wrap(text, width - 6 - indent) or [""]
            out.append(prefix + wrapped[0])
            for cont in wrapped[1:]:
                out.append(" " * (indent + 4) + cont)
            continue
        m = re.match(r"^(\s*)(\d+)\.\s+(.*)$", stripped)
        if m:
            indent = len(m.group(1))
            num = m.group(2)
            text = _inline(m.group(3))
            prefix = " " * indent + cyan("  %s. " % num)
            wrapped = textwrap.wrap(text, width - 6 - indent) or [""]
            out.append(prefix + wrapped[0])
            for cont in wrapped[1:]:
                out.append(" " * (indent + 5) + cont)
            continue
        if not stripped.strip():
            out.append("")
            continue
        text = _inline(stripped)
        # Do not hard wrap Arabic lines as aggressively; wrap on spaces either way.
        for w in textwrap.wrap(text, width) or [""]:
            out.append(w)
    return "\n".join(out)

def page(text):
    if sys.stdout.isatty() and shutil.which("less"):
        try:
            p = subprocess.Popen(["less", "-R", "-X", "-F"], stdin=subprocess.PIPE)
            p.communicate(text.encode("utf-8", "replace"))
            return
        except Exception:
            pass
    print(text)

# --- Live checks against the local targets -----------------------------------

def _tcp_connect(host, port, timeout=1.5):
    try:
        s = socket.create_connection((host, port), timeout=timeout)
        return s
    except Exception:
        return None

def _http_get(path="/", host="127.0.0.1", port=TARGET_HTTP, timeout=2.0):
    s = _tcp_connect(host, port, timeout)
    if not s:
        return None, ""
    try:
        req = "GET %s HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n\r\n" % (path, host)
        s.sendall(req.encode())
        chunks = []
        s.settimeout(timeout)
        while True:
            b = s.recv(4096)
            if not b:
                break
            chunks.append(b)
        data = b"".join(chunks).decode("latin-1", "replace")
    except Exception:
        data = ""
    finally:
        s.close()
    if "\r\n\r\n" in data:
        head, body = data.split("\r\n\r\n", 1)
    else:
        head, body = data, ""
    return head, body

def _listening_tcp_ports():
    ports = set()
    try:
        out = subprocess.check_output(["ss", "-H", "-ltn"], stderr=subprocess.DEVNULL).decode()
    except Exception:
        try:
            out = subprocess.check_output(["netstat", "-ltn"], stderr=subprocess.DEVNULL).decode()
        except Exception:
            return ports
    for line in out.splitlines():
        m = re.findall(r"[:.](\d+)\s", line + " ")
        # local address is usually the 4th column; grab all :port tokens and
        # keep the ones that look like a bound local port
        cols = line.split()
        for tok in cols:
            mm = re.search(r":(\d+)$", tok)
            if mm:
                try:
                    ports.add(int(mm.group(1)))
                except ValueError:
                    pass
    return ports

def check_listening_tcp_count(answer):
    ports = _listening_tcp_ports()
    truth = len(ports)
    try:
        given = int(re.sub(r"[^0-9]", "", answer))
    except ValueError:
        return False, "Give a plain number."
    if given == truth:
        return True, ""
    return False, "Count the unique local ports in the LISTEN state."

def check_http_server_banner(answer):
    head, _ = _http_get("/")
    if head is None:
        return False, "The web target on port %d is not answering." % TARGET_HTTP
    m = re.search(r"(?im)^Server:\s*(.+?)\s*$", head)
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower() or (answer.strip() and answer.strip().lower() in truth.lower()):
        return True, ""
    return False, "Look at the Server response header from port %d." % TARGET_HTTP

def check_http_lab_token(answer):
    head, _ = _http_get("/")
    if head is None:
        return False, "The web target on port %d is not answering." % TARGET_HTTP
    m = re.search(r"(?im)^X-Lab-Token:\s*(.+?)\s*$", head)
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, "Capture the HTTP response and read the X-Lab-Token header."

def check_http_cleartext_cred(answer):
    _, body = _http_get("/login")
    m = re.search(r"password=([^\s<\"']+)", body or "")
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, "Request /login on port %d and read the password sent in the clear." % TARGET_HTTP

def check_tls_cn(answer):
    ctx = ssl._create_unverified_context()
    try:
        raw = socket.create_connection(("127.0.0.1", TARGET_HTTPS), timeout=2.0)
        ss = ctx.wrap_socket(raw, server_hostname="shabakah.lab")
        cert = ss.getpeercert()
        ss.close()
    except Exception:
        # getpeercert on an unverified context can be empty; fall back to openssl
        cert = None
    truth = ""
    if cert:
        for tup in cert.get("subject", ()):
            for k, v in tup:
                if k == "commonName":
                    truth = v
    if not truth and shutil.which("openssl"):
        try:
            out = subprocess.check_output(
                "echo | openssl s_client -connect 127.0.0.1:%d 2>/dev/null "
                "| openssl x509 -noout -subject 2>/dev/null" % TARGET_HTTPS,
                shell=True).decode()
            m = re.search(r"CN\s*=\s*([^,/\n]+)", out)
            truth = m.group(1).strip() if m else ""
        except Exception:
            truth = ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, "Inspect the certificate subject on port %d with openssl s_client." % TARGET_HTTPS

def check_enum_banner(answer):
    s = _tcp_connect("127.0.0.1", TARGET_ENUM)
    if not s:
        return False, "The enumeration target on port %d is not answering." % TARGET_ENUM
    try:
        s.settimeout(2.0)
        data = s.recv(256).decode("latin-1", "replace")
    except Exception:
        data = ""
    finally:
        s.close()
    m = re.search(r"(v\d+(?:\.\d+)?)", data)
    truth = m.group(1) if m else ""
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, "Grab the banner from port %d and read the version." % TARGET_ENUM

def check_open_ports(answer):
    lab_ports = [TARGET_HTTP, TARGET_HTTPS, TARGET_ENUM]
    allowed = set(lab_ports) | {22, TARGET_DNS}
    open_now = set()
    for p in lab_ports:
        s = _tcp_connect("127.0.0.1", p, timeout=1.0)
        if s:
            open_now.add(p)
            s.close()
    if not open_now:
        return False, "The practice targets are not answering. Run 'netsec targets' to check."
    given = set(int(x) for x in re.findall(r"\d+", answer))
    if open_now.issubset(given) and given.issubset(allowed):
        return True, ""
    return False, ("Scan localhost and list the open application ports (%s)."
                   % ", ".join(str(p) for p in lab_ports))

def check_dns_web_ip(answer):
    truth = ""
    if shutil.which("dig"):
        try:
            out = subprocess.check_output(
                ["dig", "+short", "@127.0.0.1", "-p", str(TARGET_DNS), "web.shabakah.lab", "A"],
                stderr=subprocess.DEVNULL).decode().strip()
            truth = out.splitlines()[0].strip() if out else ""
        except Exception:
            truth = ""
    if truth and truth in answer:
        return True, ""
    return False, "Resolve web.shabakah.lab against the lab resolver on port %d." % TARGET_DNS

def check_udp_banner(answer):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(2.0)
        s.sendto(b"PING", ("127.0.0.1", TARGET_UDP))
        data, _ = s.recvfrom(512)
        s.close()
        reply = data.decode("latin-1", "replace").strip()
    except Exception:
        return False, "The UDP service on port %d did not answer. Send PING with nc -u." % TARGET_UDP
    if reply and reply.lower() in answer.lower():
        return True, ""
    return False, "Send PING to udp port %d and read the one word reply." % TARGET_UDP

def check_console_hostname(answer):
    try:
        s = socket.create_connection(("127.0.0.1", TARGET_CONSOLE), timeout=2.0)
        s.settimeout(3.0)

        def until(marker):
            buf = b""
            while marker not in buf and len(buf) < 4096:
                chunk = s.recv(256)
                if not chunk:
                    break
                buf += chunk
            return buf

        until(b"login:")
        s.sendall(b"admin\r\n")
        until(b"Password:")
        s.sendall(b"lab-P@ss\r\n")
        until(b"console>")
        s.sendall(b"HOSTNAME\r\n")
        out = until(b"console>").decode("latin-1", "replace")
        s.sendall(b"LOGOUT\r\n")
        s.close()
    except Exception:
        return False, "Could not reach the console on port %d." % TARGET_CONSOLE
    truth = ""
    for line in out.splitlines():
        line = line.strip()
        if line and "console>" not in line and "welcome" not in line.lower():
            truth = line
    if truth and truth.lower() in answer.lower():
        return True, ""
    return False, "Log in to the console on port %d and run HOSTNAME." % TARGET_CONSOLE

DYNAMIC_CHECKS = {
    "listening_tcp_count": check_listening_tcp_count,
    "http_server_banner": check_http_server_banner,
    "http_lab_token": check_http_lab_token,
    "http_cleartext_cred": check_http_cleartext_cred,
    "tls_cn": check_tls_cn,
    "enum_banner": check_enum_banner,
    "open_ports": check_open_ports,
    "dns_web_ip": check_dns_web_ip,
    "udp_banner": check_udp_banner,
    "console_hostname": check_console_hostname,
}

def check_static(answer, expected, mode):
    a = answer.strip()
    e = (expected or "").strip()
    if mode == "regex":
        try:
            return bool(re.search(e, a, re.IGNORECASE)), ""
        except re.error:
            return False, ""
    if mode == "exact":
        return a.lower() == e.lower(), ""
    # default: contains, in either direction, split accepted answers on |
    for alt in e.split("|"):
        alt = alt.strip()
        if alt and (alt.lower() in a.lower() or a.lower() == alt.lower()):
            return True, ""
    return False, ""

def run_challenge(meta, answer):
    ctype = meta.get("challenge_type", "").strip()
    if ctype == "dynamic":
        fn = DYNAMIC_CHECKS.get(meta.get("challenge_check", "").strip())
        if not fn:
            return None, ""
        return fn(answer)
    if ctype == "static":
        ok, _ = check_static(answer, meta.get("challenge_answer", ""),
                             meta.get("challenge_match", "contains"))
        return ok, ""
    return None, ""

# --- Views -------------------------------------------------------------------

def banner():
    lang = get_lang()
    line = cyan("=" * 64)
    print(line)
    print(bcyan("  SHABAKAH  ") + dim("|") + "  " + bold("شبكة"))
    print("  " + dim(t("tagline")))
    print("  " + dim("v" + VERSION + "  |  github.com/SiteQ8/Shabakah"))
    print(line)
    print("  " + yellow(t("authorized")))
    lessons = load_lessons()
    done = sum(1 for m in lessons if is_complete(m.get("id")))
    got, ptotal = score()
    if done or got:
        print("  " + dim(t("welcome_back") + "  ")
              + green("%d/%d " % (done, len(lessons))) + dim("lessons  ")
              + byellow("%d/%d " % (got, ptotal)) + dim("pts"))
    print()

def show_lessons_list():
    lessons = load_lessons()
    print()
    print(bold(t("lessons_title")))
    print(dim("-" * 40))
    for m in lessons:
        mark = bgreen("[x]") if is_complete(m.get("id")) else dim("[ ]")
        num = bold("%2s" % m.get("id"))
        title = m.get("title", "")
        print("  %s  %s  %s" % (mark, num, title))
    print()

def _strip_leading_h1(body):
    lines = body.split("\n")
    i = 0
    while i < len(lines) and not lines[i].strip():
        i += 1
    if i < len(lines) and lines[i].lstrip().startswith("# "):
        del lines[i]
        if i < len(lines) and not lines[i].strip():
            del lines[i]
    return "\n".join(lines)

def show_lesson(meta):
    body = render_markdown(_strip_leading_h1(meta.get("_body", "")))
    parts = []
    parts.append(bold("# " + meta.get("title", "")))
    parts.append(dim("=" * min(term_width(), 60)))
    if meta.get("objective"):
        parts.append("")
        parts.append(bcyan(t("objective") + ": ") + meta["objective"])
    parts.append("")
    parts.append(body)
    parts.append("")
    parts.append(cyan("-" * min(term_width(), 60)))
    parts.append(byellow(t("challenge")))
    if meta.get("challenge_prompt"):
        parts.append(meta["challenge_prompt"])
    if meta.get("challenge_hint"):
        parts.append(dim(t("hint") + ": " + meta["challenge_hint"]))
    if meta.get("challenge_type", "") in ("static", "dynamic"):
        parts.append("")
        parts.append(t("try_check"))
        parts.append("  " + green("netsec check %s <your answer>" % meta.get("id")))
    else:
        parts.append(dim(t("no_challenge")))
    parts.append("")
    page("\n".join(parts))

def lessons_menu():
    while True:
        show_lessons_list()
        try:
            sel = input(bold(t("pick_lesson") + ": ")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if sel.lower() in ("b", "back", "q", ""):
            return
        meta = find_lesson(sel)
        if not meta:
            print("  " + red(t("no_such")))
            continue
        show_lesson(meta)
        try:
            input(dim("  " + t("press_enter") + " "))
        except (EOFError, KeyboardInterrupt):
            print()
            return

def show_progress():
    lessons = load_lessons()
    total = len(lessons)
    done = sum(1 for m in lessons if is_complete(m.get("id")))
    print()
    print(bold(t("progress_title")))
    print(dim("-" * 40))
    width = 30
    filled = int(width * done / total) if total else 0
    bar = bgreen("#" * filled) + dim("." * (width - filled))
    print("  [" + bar + "]  %d/%d" % (done, total))
    print()
    print("  " + (t("completed_n") % (done, total)))
    got, ptotal = score()
    found = len(get_found_flags())
    print("  " + (t("ctf_score") % (got, ptotal, found, len(FLAGS))))
    unlocked = sum(1 for a in _ach_defs() if a["unlocked"])
    print("  " + t("ach_title").title() + ": %d/%d" % (unlocked, len(_ach_defs())))
    print()

def targets_status():
    print()
    print(bold(t("targets_title")))
    print(dim("-" * 40))
    checks = [
        ("SSH", 22, "the door you came in through"),
        ("HTTP  (cleartext web)", TARGET_HTTP, "banner grab, header and cleartext analysis"),
        ("HTTPS (TLS web)", TARGET_HTTPS, "certificate and TLS inspection"),
        ("ENUM  (raw TCP banner)", TARGET_ENUM, "service enumeration practice"),
        ("CONSOLE (cleartext)", TARGET_CONSOLE, "reused credential, cleartext login"),
        ("DNS   (lab resolver)", TARGET_DNS, "name resolution practice"),
        ("UDP   (banner)", TARGET_UDP, "udp scanning practice"),
    ]
    for name, port, note in checks:
        s = _tcp_connect("127.0.0.1", port, timeout=0.8)
        up = s is not None
        if s:
            s.close()
        state = bgreen(" %s " % t("up")) if up else red(" %s " % t("down"))
        print("  %s  %s  %s" % (state, bold("%-24s" % (name + " :" + str(port))), dim(note)))
    print()

