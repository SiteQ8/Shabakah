#!/usr/bin/env python3
# Shabakah - interactive network security lab and tutor.
# Author: Ali AlEnezi (SiteQ8)
# License: MIT
#
# This is the guide you talk to after you SSH into the lab. It serves the
# lessons, points you at the local practice targets, sets a hands on
# challenge for every lesson, and checks your answer live inside the box.

import os
import re
import sys
import json
import socket
import shutil
import ssl
import subprocess
import textwrap

VERSION = "1.0.0"

# --- Paths -------------------------------------------------------------------

LESSON_ROOT = os.environ.get("SHABAKAH_LESSONS", "/opt/shabakah/lessons")
STATE_DIR = os.path.join(os.path.expanduser("~"), ".shabakah")
CONFIG_PATH = os.path.join(STATE_DIR, "config.json")
PROGRESS_PATH = os.path.join(STATE_DIR, "progress.json")

# Ports used by the local practice targets. Kept in one place so the tutor,
# the checks, and the targets script agree.
TARGET_HTTP = 8080
TARGET_HTTPS = 8443
TARGET_ENUM = 9000
TARGET_DNS = 5353

# --- Colours -----------------------------------------------------------------

def _supports_colour():
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()

_C = _supports_colour()

def c(code, text):
    if not _C:
        return text
    return "\033[%sm%s\033[0m" % (code, text)

def bold(t):    return c("1", t)
def dim(t):     return c("2", t)
def red(t):     return c("31", t)
def green(t):   return c("32", t)
def yellow(t):  return c("33", t)
def blue(t):    return c("34", t)
def magenta(t): return c("35", t)
def cyan(t):    return c("36", t)
def bcyan(t):   return c("1;36", t)
def bgreen(t):  return c("1;32", t)
def byellow(t): return c("1;33", t)

