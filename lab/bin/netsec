        ("Read a pcap you saved", "tcpdump -nr capture.pcap"),
        ("Scan a UDP port", "sudo nmap -sU -p 9001 127.0.0.1"),
        ("Poke the UDP service", "printf 'PING' | nc -u -w1 127.0.0.1 9001"),
        ("Find hidden web paths", "curl -s http://127.0.0.1:8080/robots.txt"),
        ("List firewall rules", "sudo iptables -L -n -v"),
    ],
