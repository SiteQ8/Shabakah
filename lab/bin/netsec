def _flag_by_id(fid):
    for f in FLAGS:
        if f["id"] == fid:
            return f
    return None

def get_found_flags():
    return set(get_progress().get("flags", []))

def record_flag(fid):
    prog = get_progress()
    found = set(prog.get("flags", []))
    found.add(fid)
    prog["flags"] = sorted(found)
    _save_json(PROGRESS_PATH, prog)

def submit_flag(text):
    """Return (status, flag_dict). status in new, already, unknown."""
    norm = text.strip()
    for f in FLAGS:
        if norm == f["flag"] or norm == f["id"]:
            if f["id"] in get_found_flags():
                return "already", f
            record_flag(f["id"])
            return "new", f
    return "unknown", None

def score():
    found = get_found_flags()
    got = sum(f["points"] for f in FLAGS if f["id"] in found)
    total = sum(f["points"] for f in FLAGS)
    return got, total

