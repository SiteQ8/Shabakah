def cheat_sheet():
    rows = CHEAT.get(get_lang(), CHEAT["en"])
    print()
    print(bold(t("cheat_title")))
    print(dim("-" * 40))
    for label, cmd in rows:
        print("  " + label)
        print("    " + green(cmd))
    print()

def ctf_board():
    lang = get_lang()
    found = get_found_flags()
    got, total = score()
    fg, ft = len([f for f in FLAGS if f["id"] in found]), len(FLAGS)
    print()
    print(bold(t("ctf_title")))
    print(dim("-" * 40))
    print("  " + t("ctf_intro"))
    print()
    print("  " + byellow(t("ctf_score") % (got, total, fg, ft)))
    print()
    for f in FLAGS:
        hit = f["id"] in found
        mark = bgreen("[x]") if hit else dim("[ ]")
        title = f["title_ar"] if lang == "ar" else f["title_en"]
        pts = dim("(%d %s)" % (f["points"], t("ctf_points_each")))
        state = green(t("ctf_found")) if hit else dim(t("ctf_hidden"))
        print("  %s  %s  %s  %s" % (mark, bold("%-22s" % title), pts, state))
        if hit:
            where = f["where_ar"] if lang == "ar" else f["where_en"]
            print("       " + dim(where))
    print()
    print("  " + dim(t("ctf_submit_usage")))
    print()

def cmd_submit(args):
    if not args:
        print(t("ctf_submit_usage"))
        return 2
    before = {a["id"] for a in _ach_defs() if a["unlocked"]}
    status, f = submit_flag(" ".join(args))
    lang = get_lang()
    if status == "new":
        title = f["title_ar"] if lang == "ar" else f["title_en"]
        print(bgreen("  " + t("ctf_new")) + "  " + bold(title)
              + "  " + dim("(+%d %s)" % (f["points"], t("ctf_points_each"))))
        got, total = score()
        print("  " + byellow(t("ctf_score").split(",")[0] % (got, total)))
        after = {a["id"] for a in _ach_defs() if a["unlocked"]}
        for aid in sorted(after - before):
            a = next(x for x in _ach_defs() if x["id"] == aid)
            name = a["ar"] if lang == "ar" else a["en"]
            print("  " + byellow(t("ach_new")) + " " + bold(name))
        return 0
    if status == "already":
        print(dim("  " + t("ctf_already")))
        return 0
    print(red("  " + t("ctf_unknown")))
    return 1

def achievements_view():
    lang = get_lang()
    print()
    print(bold(t("ach_title")))
    print(dim("-" * 40))
    for a in _ach_defs():
        mark = bgreen("[x]") if a["unlocked"] else dim("[ ]")
        name = a["ar"] if lang == "ar" else a["en"]
        desc = a["desc_ar"] if lang == "ar" else a["desc_en"]
        print("  %s  %s" % (mark, bold(name)))
        print("       " + dim(desc))
    print()

def toggle_lang():
    set_lang("ar" if get_lang() == "en" else "en")
    print("  " + green(t("lang_set")))

# --- Menu loop ---------------------------------------------------------------

def main_menu():
    banner()
    while True:
        print(bold(t("menu_title")))
        print(dim("-" * 40))
        items = [
            ("1", t("m_lessons")),
            ("2", t("m_progress")),
            ("3", t("m_targets")),
            ("4", t("m_cheat")),
            ("5", t("m_ctf")),
            ("6", t("m_achievements")),
            ("7", t("m_lang")),
            ("8", t("m_shell")),
            ("9", t("m_quit")),
        ]
        for k, label in items:
            print("  " + bold(k) + ")  " + label)
        print()
        try:
            sel = input(bold(t("choose") + ": ")).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        print()
        if sel in ("1", "l"):
            lessons_menu()
        elif sel in ("2", "p"):
            show_progress()
        elif sel in ("3", "t"):
            targets_status()
        elif sel in ("4", "c"):
            cheat_sheet()
        elif sel in ("5", "f"):
            ctf_board()
        elif sel in ("6", "a"):
            achievements_view()
        elif sel in ("7",):
            toggle_lang()
            banner()
        elif sel in ("8", "s"):
            print("  " + dim(t("shell_note")))
            return
        elif sel in ("9", "q", "quit", "exit"):
            return
        else:
            print("  " + red(t("unknown_cmd")))

# --- CLI ---------------------------------------------------------------------

def cli_help():
    print(bold(t("help_title")))
    print("""
  netsec                  open the interactive guide
  netsec lessons          list all lessons
  netsec lesson <id>      read one lesson
  netsec check <id> <a>   check your challenge answer
  netsec targets          show lab target status
  netsec cheat            command cheat sheet
  netsec progress         show your progress and score
  netsec ctf              show the capture the flag board
  netsec ctf hint <id>    show where a flag is hidden
  netsec submit flag{...} submit a flag you found
  netsec achievements     show unlocked achievements
  netsec lang [en|ar]     get or set the language
  netsec version          print the version
""")

def cmd_check(args):
    if len(args) < 2:
        print(t("check_usage"))
        return 2
    lesson_id = args[0]
    answer = " ".join(args[1:])
    meta = find_lesson(lesson_id)
    if not meta:
        print(red(t("no_such")))
        return 2
    result, feedback = run_challenge(meta, answer)
    if result is None:
        print(dim(t("no_challenge")))
        return 0
    if result:
        mark_complete(meta.get("id"))
        print(bgreen("  " + t("correct")))
        return 0
    print(red("  " + t("incorrect")))
    if feedback:
        print(dim("  " + feedback))
    return 1

def main(argv):
    if not argv:
        main_menu()
        return 0
    cmd = argv[0].lower()
    rest = argv[1:]
    if cmd in ("lessons", "list"):
        show_lessons_list()
    elif cmd == "lesson":
        if not rest:
            show_lessons_list()
        else:
            meta = find_lesson(rest[0])
            if not meta:
                print(red(t("no_such")))
                return 2
            show_lesson(meta)
    elif cmd == "check":
        return cmd_check(rest)
    elif cmd == "targets":
        targets_status()
    elif cmd == "cheat":
        cheat_sheet()
    elif cmd == "progress":
        show_progress()
    elif cmd in ("ctf", "flags"):
        if rest and rest[0].lower() == "hint":
            if len(rest) < 2:
                print(t("ctf_hint_usage"))
                return 2
            f = _flag_by_id(rest[1].strip())
            if not f:
                print(red(t("ctf_unknown")))
                return 2
            where = f["where_ar"] if get_lang() == "ar" else f["where_en"]
            print("  " + where)
        else:
            ctf_board()
    elif cmd == "submit":
        return cmd_submit(rest)
    elif cmd in ("achievements", "ach"):
        achievements_view()
    elif cmd == "lang":
        if rest:
            set_lang(rest[0])
        print("lang = " + get_lang())
    elif cmd in ("version", "-v", "--version"):
        print("shabakah " + VERSION)
    elif cmd in ("help", "-h", "--help"):
        cli_help()
    else:
        print(red(t("unknown_cmd")))
        cli_help()
        return 2
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except BrokenPipeError:
        # A reader closed early (piping into head, grep -q, and the like).
        # Redirect stdout to devnull so the interpreter shutdown flush stays quiet.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except Exception:
            pass
        sys.exit(0)
